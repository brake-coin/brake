{
  "name": "brake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run build && node --watch apps/server/src/index.mjs",
    "dev:static": "node scripts/dev-site.mjs",
    "start": "node apps/server/src/index.mjs",
    "build": "node scripts/build-site.mjs",
    "bot:dry-run": "node apps/bot/src/index.mjs --dry-run",
    "validate": "node scripts/validate-repo.mjs",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm run validate && pnpm run test && pnpm run build"
  }
}
