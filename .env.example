# Live posting is intentionally unavailable in the initial repository setup.
BRAKE_ENV=development
BRAKE_ALLOW_LIVE_POSTING=false
BRAKE_SOLANA_CLUSTER=devnet

# The public meme generator uses visitor-owned OpenRouter OAuth PKCE in the browser.
# The shared bot key is connected at /admin and stored on the private data volume.
PORT=8080
PUBLIC_APP_URL=http://localhost:8080
STOPAI_DATA_DIR=.data
STOPAI_ADMIN_PASSWORD=

# Optional fallback. The normal setup pastes the BotFather token into /admin.
TELEGRAM_BOT_TOKEN=
STOPAI_REQUIRE_TELEGRAM=false
TELEGRAM_GROUP_HANDLE=StopAiCoin
TELEGRAM_REPLIES_ENABLED=true
TELEGRAM_IMAGES_ENABLED=true
TELEGRAM_VIDEOS_ENABLED=true
# Comma-separated numeric Telegram user IDs. Operators can remove gallery items and
# change durable agent goals or memory. Every user may request an agent-approved X post.
TELEGRAM_OPERATOR_IDS=
OPENROUTER_CHAT_MODEL=~google/gemini-flash-latest
OPENROUTER_SERVER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite
CHAT_HOURLY_CAP=30
CHAT_DAILY_CAP=200
CHAT_USER_HOURLY_CAP=10
CHAT_USER_DAILY_CAP=50
IMAGE_HOURLY_CAP=2
IMAGE_DAILY_CAP=10
IMAGE_USER_HOURLY_CAP=1
IMAGE_USER_DAILY_CAP=3
VIDEO_HOURLY_CAP=1
VIDEO_DAILY_CAP=2
VIDEO_USER_HOURLY_CAP=1
VIDEO_USER_DAILY_CAP=1
MEDIA_DAILY_SPEND_CAP_USD=5

# Preferred X setup is OAuth 2.0 PKCE through /admin. X_CLIENT_ID is an optional
# public fallback; it can also be entered in the admin page. A manually managed user
# access token remains available as an environment fallback.
X_POSTING_ENABLED=false
X_EXPECTED_USERNAME=STOPAICOIN
X_CLIENT_ID=
X_USER_ACCESS_TOKEN=
X_POST_VERIFY_ATTEMPTS=3
X_POST_VERIFY_DELAY_MS=750
X_POST_HOURLY_CAP=2
X_POST_DAILY_CAP=8
X_POST_USER_HOURLY_CAP=1
X_POST_USER_DAILY_CAP=3
X_POST_GLOBAL_COOLDOWN_SECONDS=3600
X_POST_USER_COOLDOWN_SECONDS=14400

# Persistent campaign agent. It researches every scheduler cycle, but may skip.
# X queries are separated with ;; so normal X operators remain readable.
X_AUTONOMOUS_POSTING_ENABLED=true
X_AUTONOMOUS_INTERVAL_MINUTES=120
X_AUTONOMOUS_START_DELAY_MINUTES=15
X_AUTONOMOUS_HOURLY_CAP=3
X_AUTONOMOUS_DAILY_CAP=3
X_AUTONOMOUS_TYPES=text,image,video
AGENT_RESEARCH_ENABLED=true
AGENT_WATCH_ACCOUNTS=canadabirdie,PauseAI
AGENT_X_QUERIES=
AGENT_NEWS_FEEDS=
AGENT_CANDIDATE_LIMIT=14
AGENT_X_RESEARCH_HOURLY_CAP=4
AGENT_X_RESEARCH_DAILY_CAP=24
AGENT_MIN_POST_INTERVAL_MINUTES=240
AGENT_MAX_SOURCE_AGE_HOURS=168
