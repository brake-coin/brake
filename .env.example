# Live posting is intentionally unavailable in the initial repository setup.
BRAKE_ENV=development
BRAKE_ALLOW_LIVE_POSTING=false
BRAKE_SOLANA_CLUSTER=devnet

# Protects /admin. OpenRouter itself is linked through OAuth PKCE on that page.
BRAKE_ADMIN_PASSWORD=
BRAKE_DATA_DIR=.data
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_APP_NAME=STOPAI Meme Generator

# Meme generator service settings.
PORT=8080
PUBLIC_APP_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://brake-coin.github.io
MEME_RATE_LIMIT=3
MEME_RATE_WINDOW_MS=600000
MEME_MAX_CONCURRENT=2

# Add only after a reviewed bot transport is implemented.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
X_USER_ACCESS_TOKEN=

# Published only after board approval and wallet setup.
BRAKE_GRANTS_WALLET=
