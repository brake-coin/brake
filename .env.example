# Live posting is intentionally unavailable in the initial repository setup.
BRAKE_ENV=development
BRAKE_ALLOW_LIVE_POSTING=false
BRAKE_SOLANA_CLUSTER=devnet

# The public meme generator uses visitor-owned OpenRouter OAuth PKCE in the browser.
# The shared bot key is connected at /admin and stored on the private data volume.
PORT=8080
PUBLIC_APP_URL=http://localhost:8080
STOPAI_DATA_DIR=.data
STOPAI_ADMIN_PASSWORD=

# Optional fallback. The normal setup pastes the BotFather token into /admin.
TELEGRAM_BOT_TOKEN=
STOPAI_REQUIRE_TELEGRAM=false
TELEGRAM_REPLIES_ENABLED=true
TELEGRAM_IMAGES_ENABLED=true
TELEGRAM_VIDEOS_ENABLED=true
# Comma-separated numeric Telegram user IDs. Operators can remove gallery items and
# prepare confirmed X posts. Ask the bot "what is my Telegram ID?" to find yours.
TELEGRAM_OPERATOR_IDS=
OPENROUTER_CHAT_MODEL=openrouter/auto
OPENROUTER_SERVER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite
CHAT_HOURLY_CAP=30
CHAT_DAILY_CAP=200
CHAT_USER_HOURLY_CAP=10
CHAT_USER_DAILY_CAP=50
IMAGE_HOURLY_CAP=2
IMAGE_DAILY_CAP=10
IMAGE_USER_HOURLY_CAP=1
IMAGE_USER_DAILY_CAP=3
VIDEO_HOURLY_CAP=1
VIDEO_DAILY_CAP=2
VIDEO_USER_HOURLY_CAP=1
VIDEO_USER_DAILY_CAP=1
MEDIA_DAILY_SPEND_CAP_USD=5

# X posting stays off unless all three settings are present. Use an OAuth 2.0 PKCE
# user access token with tweet.read, tweet.write, users.read, and media.write scopes.
X_POSTING_ENABLED=false
X_USER_ACCESS_TOKEN=
